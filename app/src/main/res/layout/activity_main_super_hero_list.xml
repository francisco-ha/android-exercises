<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/todo_background_todo_app"
    tools:context=".superheroapp.MainSuperHeroListActivity">
  <ProgressBar
      android:id="@+id/progressBar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      android:visibility="gone" />

  <!--0dp en los constraint es como decir match_parent-->
  <androidx.appcompat.widget.SearchView
      android:id="@+id/searchView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:iconifiedByDefault="false"
      app:queryHint="Escribe aquí tu búsqueda..."
      android:theme="@style/SearchViewTheme"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- layout_width y layout_height en 0dp para responder a las restricciones -->
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
      android:id="@+id/swipe"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintTop_toBottomOf="@+id/searchView"
      app:layout_constraintBottom_toTopOf="@+id/btnAddNewItem"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <!-- El RecyclerView solo necesita match_parent dentro de SwipeRefreshLayout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuperHero"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  <Button
      android:id="@+id/btnAddNewItem"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="add New Item"
      app:layout_constraintTop_toBottomOf="@+id/swipe"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>